{
  "name": "search-failover",
  "version": "0.3.0",
  "description": "搜索故障转移网关 MCP：聚合博查/Tavily/Brave/Exa/DuckDuckGo 默认链，可选启用智谱/百度千帆/Serper (Search failover gateway MCP: default chain of Bocha/Tavily/Brave/Exa/DuckDuckGo with opt-in Zhipu/Qianfan/Serper and automatic failover)",
  "type": "module",
  "license": "MIT",
  "author": "crisweb1994",
  "repository": {
    "type": "git",
    "url": "https://github.com/crisweb1994/search-failover.git"
  },
  "bugs": {
    "url": "https://github.com/crisweb1994/search-failover/issues"
  },
  "homepage": "https://github.com/crisweb1994/search-failover#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "search",
    "web-search",
    "failover",
    "search-engine",
    "tavily",
    "brave",
    "bocha",
    "exa",
    "duckduckgo",
    "zhipu",
    "qianfan",
    "serper",
    "ai-agent"
  ],
  "bin": {
    "search-failover": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "docs",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
