{
  "name": "search-failover",
  "version": "0.4.0",
  "description": "Web search MCP server with automatic failover across Bocha/Tavily/Brave/Exa/SearXNG/DuckDuckGo (opt-in Zhipu/Qianfan/Serper); stdio and Streamable HTTP, zero runtime dependencies. 搜索故障转移 MCP：多家搜索 API 自动兜底，支持 stdio 与 Streamable HTTP。",
  "type": "module",
  "license": "MIT",
  "author": "crisweb1994",
  "repository": {
    "type": "git",
    "url": "https://github.com/crisweb1994/search-failover.git"
  },
  "bugs": {
    "url": "https://github.com/crisweb1994/search-failover/issues"
  },
  "homepage": "https://github.com/crisweb1994/search-failover#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "search",
    "web-search",
    "failover",
    "search-engine",
    "streamable-http",
    "tavily",
    "brave",
    "bocha",
    "exa",
    "searxng",
    "duckduckgo",
    "zhipu",
    "qianfan",
    "serper",
    "ai-agent"
  ],
  "bin": {
    "search-failover": "dist/index.js"
  },
  "files": [
    "dist",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "plugin:sync": "node scripts/plugin-sync.mjs",
    "plugin:check": "node scripts/plugin-sync.mjs --check",
    "prepublishOnly": "npm run typecheck && npm test && npm run plugin:check && npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.2",
    "htmlparser2": "^10.1.0",
    "msw": "^2.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "undici": "^6.29.1",
    "vitest": "^3.0.0",
    "zod": "^3.25.76"
  }
}
