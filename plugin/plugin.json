{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "search-failover",
  "version": "0.2.0",
  "description": "Aggregated web search with automatic failover: Bocha/Tavily/Brave/Exa/DuckDuckGo by default, opt-in Zhipu/Qianfan/Serper. Works with zero API keys (DuckDuckGo fallback).",
  "author": {
    "name": "crisweb1994",
    "url": "https://github.com/crisweb1994"
  },
  "homepage": "https://github.com/crisweb1994/search-failover#readme",
  "repository": "https://github.com/crisweb1994/search-failover",
  "license": "MIT",
  "keywords": [
    "search",
    "web-search",
    "mcp",
    "failover",
    "search-engine"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Search Failover",
        "shortDescription": "Aggregated web search with automatic provider failover",
        "developerName": "crisweb1994",
        "category": "Productivity",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://github.com/crisweb1994/search-failover#readme"
      }
    }
  }
}
